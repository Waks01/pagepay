# backend/.env.example
DATABASE_URL=postgresql+asyncpg://pagepay:CHANGE_ME@db-host/pagepay
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://pagepay-fff6.onrender.com

# Admin / cron shared secret. Required by X-Admin-Token on /admin/* routes.
# The cron container and operator scripts must send this exact value.
ADMIN_TOKEN=dev-admin-token

# Content providers
GNEWS_API_KEY=
GUTENDEX_BASE_URL=https://gutendex.com

# Flutterwave (Phase 4)
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# AI providers (Phase 3 — Student AI Exam Prep)
# Get keys from:
#   Gemini:  https://aistudio.google.com/app/apikey
#   Groq:    https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# AdMob (Phase 2)
ADMOB_APP_ID_ANDROID=
ADMOB_APP_ID_IOS=

# AppLovin (Phase 2)
APPLOVIN_SDK_KEY=
APPLOVIN_INITIALIZATION_SCORE=

# Paystack (Phase 4 — Payments). Get keys from https://dashboard.paystack.com/#/settings/developers.
# NOTE: Paystack signs webhooks using your SECRET KEY (not a separate webhook secret).
# Just configure the webhook URL in Paystack dashboard - no secret needed!
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Public base URL we expose in Paystack's dashboard for return + webhook
# URLs. Defaults to localhost for `paystack-cli listen-forward`; override
# in production to the real public domain (e.g. https://pagepay-fff6.onrender.com).
# IMPORTANT: Use HTTPS in production!
PUBLIC_BASE_URL=http://localhost:8000

# Frontend URL for redirects after payment completion (wallet funding, subscriptions).
# Development: Use Expo dev client URL (exp://localhost:8081)
# Production: Use your production app URL or deep link scheme
# Example: https://pagepay.com or pagepay://
FRONTEND_URL=exp://localhost:8081


# Phase 7: Cloudinary for task proof uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=pagepay/tasks

# ── Platform revenue splits ──────────────────────────────────────
# Ads: platform keeps this % of ad revenue, rest goes to user as points.
# 0.20 = platform 20%, user 80%.
PLATFORM_AD_REVENUE_PERCENT=0.20
# Tasks: platform fee added on top of worker reward.
# 0.30 = platform 30%, worker 70% of total escrow.
PLATFORM_TASK_REVENUE_PERCENT=0.30

# ── Points ↔ Naira conversion (single source of truth) ───────────
# How many points are credited to a worker per ₦1 of reward. The
# backend uses this to convert task.reward_amount (stored in kobo,
# where 100 kobo = ₦1) into points_balance credits. The mobile
# client reads EXPO_PUBLIC_POINTS_PER_NAIRA with the same value so
# both sides always agree on the conversion. Default 10 = "10 pts
# per ₦1" (i.e. 1 pt = ₦0.10).
POINTS_PER_NAIRA=10

# ── Ad reward payout ─────────────────────────────────────────────
# Total points (gross) one rewarded ad is worth. The platform/user
# split is applied on top — with PLATFORM_AD_REVENUE_PERCENT=0.20,
# the user gets 16 pts (80% × 20) and the platform keeps 4 pts (20% × 20).
# Match the value you set in the AdMob dashboard for the rewarded_* units.
REWARDED_AD_PAYOUT_POINTS=20
# Bonus for finishing a 1-min reading slice, independent of ads.
# Settled at /session/end. 2 pts = ₦0.20 per slice.
READING_SLICE_BONUS_POINTS=2

# ── Image / audio cache directories ─────────────────────────────────────
# Both default to /tmp/pagepay_* on managed deploys (Render free tier
# doesn't allow writes to the app directory). On local dev, you can
# change to ./cache/image_proxy etc. for persistent inspection.
IMAGE_CACHE_DIR=/tmp/pagepay_image_cache
AUDIO_CACHE_DIR=/tmp/pagepay_audio_cache
# Cap on the image proxy responses (bytes). 10 MB default.
IMAGE_PROXY_MAX_BYTES=10485760
# How long to serve cached images (seconds). 30 days default.
IMAGE_PROXY_CACHE_TTL_SECONDS=2592000
# How long to serve cached audio (seconds). 30 days default.
AUDIO_CACHE_TTL_SECONDS=2592000

# ── Firebase Cloud Messaging ────────────────────────────────────────────
# Path to the Firebase Admin service-account JSON file (default works for
# local dev where the file is checked in as gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Optional: on managed deploys (Render, Railway, Fly), paste the full
# contents of the service-account JSON as a single env var instead of
# relying on a file path. When set, this takes precedence over the path.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}


# ── Paystack base URL + HTTP tuning ─────────────────────────────────────
# Default (https://api.paystack.co) covers both test-sandbox and live —
# Paystack switches based on the secret key prefix. Override only if
# you front Paystack with a regional proxy.
PAYSTACK_BASE_URL=https://api.paystack.co
# Per-request HTTP timeout for outbound Paystack calls (seconds).
PAYSTACK_HTTP_TIMEOUT_SECONDS=10.0
# How long to cache the GET /bank list (seconds). Nigerian banks list
# changes rarely — 1h is the safe default.
PAYSTACK_BANKS_CACHE_TTL_SECONDS=3600

# ── Peyflex VTU (Phase 8: Bills & Earn) ─────────────────────────────────
# Production client endpoint — never commit the real API key.
# Sign up at https://peyflex.com.ng to get a key.
PEYFLEX_API_KEY=
PEYFLEX_BASE_URL=https://client.peyflex.com.ng/api
# Commission share returned to the user as points. The rest funds the
# platform. 0.67 = user gets 67% of Peyflex's commission.
BILLS_USER_SHARE=0.67

# ── FX (USD → NGN) live rate lookup ──────────────────────────────────────
# Free public endpoint at open.er-api.com (no API key required). Override
# in tests / staging to point at a mock server.
FX_URL=https://open.er-api.com/v6/latest/USD
# In-process cache TTL. 60s balances "don't hammer upstream" vs
# "don't lose money to stale rates during NGN volatility".
FX_CACHE_TTL_SECONDS=60
FX_HTTP_TIMEOUT_SECONDS=5.0

# ── AI provider base URLs + default models ──────────────────────────────
# Each provider has a stable HTTP base + a moving model id. The model
# string is the default for that provider — router.py picks per task.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat:free
# OpenRouter ranks/links free-tier traffic by these — point at your
# own domain + product name so OpenRouter can attribute usage.
OPENROUTER_HTTP_REFERER=https://pagepay.ng
OPENROUTER_APP_TITLE=PagePay Study
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ── AI provider circuit breaker ─────────────────────────────────────────
# After this many consecutive failures from a single provider the
# circuit opens for `ai_circuit_open_seconds` seconds and the router
# skips that provider. State persists in `ai_provider_health`.
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_OPEN_SECONDS=300
# Default `max_tokens` for ai.router.route_ai when the caller doesn't
# pin a value. 4000 ≈ 3000 words, enough for any MCQ/flashcard/essay.
AI_DEFAULT_MAX_TOKENS=4000
# Minimum effective reading duration (seconds) before a session is
# "verified" and earns the slice bonus. Kept < 60s so the bonus
# settles even when a user skips the post-read ad.
SESSION_VERIFIED_MIN_SECONDS=30

# ── AI verification confidence thresholds ──────────────────────────────
# Floor for "verified=true" on social/URL/screenshot checks (Instagram,
# TikTok, YouTube, Twitter, …). 0.7 = verifier must be ≥70% sure.
AI_VERIFICATION_CONFIDENCE_FLOOR=0.7
# "High quality" gate that triggers the XP bonus in task_processor.
AI_HIGH_QUALITY_CONFIDENCE_FLOOR=0.95

# ── Nitter mirror list (Twitter follow verification) ────────────────────
# Comma-separated. Order = priority (first responding wins). Default
# has the 4 public mirrors we test against in CI. Override when a
# mirror dies or you want to point at a self-hosted instance.
NITTER_INSTANCES=https://nitter.net,https://nitter.space,https://lightbrd.com,https://nitter.catsarch.com

# ── Hive blockchain blog sync (Phase 5) ─────────────────────────────────
# Hive JSON-RPC endpoint. Default is the public api.hive.blog. Override
# to a local Hive node for testing.
HIVE_API_URL=https://api.hive.blog
# Base URL used to build canonical post links stored in content_catalog.
HIVE_POST_BASE_URL=https://hive.blog

# ── Premium subscription pricing ────────────────────────────────────────
# Stored in kobo (100 kobo = ₦1). Change without a deploy.
PREMIUM_MONTHLY_PRICE_KOBO=50000
PREMIUM_YEARLY_PRICE_KOBO=500000
# Multiplier applied to base rewards for active premium subscribers.
# 2.0 = "earn double points". Set to 1.0 to effectively disable the
# premium benefit without removing the tier.
PREMIUM_POINTS_MULTIPLIER=2.0

# ── Auth lockout + rate limit ───────────────────────────────────────────
# Failed-login policy. After N bad passwords the account is locked for
# M minutes. The lockout resets on next successful login.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# slowapi DSL applied to POST /auth/login. Format "<count>/<window>",
# e.g. "5/15minutes", "100/minute". See slowapi docs for windows.
AUTH_LOGIN_RATE_LIMIT=5/15minutes

# ── Referral program ────────────────────────────────────────────────────
# Points credited to the referrer / referee when the referee completes
# their first verified reading session. 500 pts = ₦50 at 10 pts/₦1.
REFERRAL_REFERRER_REWARD=500
REFERRAL_REFEREE_REWARD=200
# Hard cap on rewards one user can claim in a calendar day.
REFERRAL_DAILY_CAP=10
# Public base URL for share links: "<base>/<code>". In dev override
# with a tunnel URL (e.g. ngrok) so off-WiFi phones can resolve it.
REFERRAL_APP_BASE_URL=https://pagepay.app/ref

# ── Wallet deposit fee ──────────────────────────────────────────────────
# Platform fee on every Paystack wallet top-up.
# fee = min(ceil(deposit_kobo × percent), max_fee_kobo)
WALLET_DEPOSIT_FEE_PERCENT=0.015
WALLET_DEPOSIT_MAX_FEE_KOBO=2000
# Default platform cut on new sponsor tasks. 30 = platform 30%, worker
# 70% of the gross reward. Stored per-task so changing this only
# affects new tasks, never in-flight ones.
DEFAULT_PLATFORM_FEE_PERCENT=30

# ── Task reputation / XP curve ──────────────────────────────────────────
# XP awarded per *approved* task submission, plus the bonus when the
# AI reports "high quality" (≥ AI_HIGH_QUALITY_CONFIDENCE_FLOOR).
TASK_XP_BASE=10
TASK_XP_HIGH_QUALITY_BONUS=5
# Each level-up multiplies XP-to-next-level by this factor.
# 1.5 = classic RPG curve (50% more XP per level).
TASK_XP_LEVEL_MULTIPLIER=1.5

# ── Study unlock costs ──────────────────────────────────────────────────
# Points the user must spend to unlock a study asset. Videos cost more
# because they require AI generation. Per-row overrides exist for
# premium content.
STUDY_UNLOCK_POINTS_COST=50
STUDY_VIDEO_UNLOCK_POINTS_COST=200

# ── Database connection pool ────────────────────────────────────────────
# Async engine pool tuning. Total open connections ≈ workers ×
# (pool_size + max_overflow). Default matches asyncpg's recommended
# 30-min idle window to dodge stale-connection errors on managed
# Postgres (RDS, Supabase, Neon).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# ── HTTP request body cap ───────────────────────────────────────────────
# RequestSizeLimitMiddleware rejects anything larger than these.
# JSON/API default 1 MB, multipart (file uploads) default 10 MB.
MAX_JSON_BODY_BYTES=1048576
MAX_MULTIPART_BODY_BYTES=10485760

# ── Content slicer (casual reader) ──────────────────────────────────────
# Target chars per slice, hard cap, and "don't bother slicing if
# shorter than this" threshold. Defaults give ~1-minute reads at
# 3000 chars/min.
SLICE_TARGET_CHARS=3000
SLICE_MAX_CHARS=3900
SLICE_NO_SLICE_THRESHOLD_CHARS=3600

# ── Content slicer (education / OpenStax topic-aware) ───────────────────
# Same idea but for topic-aware slicing — chunks by topic boundary
# rather than raw char count. Defaults mirror the casual slicer.
TOPIC_SLICE_TARGET_CHARS=3000
TOPIC_SLICE_MAX_CHARS=3600
TOPIC_SLICE_SINGLE_UNIT_THRESHOLD=3000

# ── TTS (edge-tts) ──────────────────────────────────────────────────────
# Voice + rate applied to every TTS generation. See edge-tts docs for
# the full voice list (https://github.com/rany2/edge-tts#voices).
TTS_DEFAULT_VOICE=en-US-AriaNeural
TTS_DEFAULT_RATE=+0%
# Max parallel TTS calls in batch jobs. 5 is the sweet spot for the
# free Microsoft tier — bump at your own rate-limit risk.
TTS_BATCH_CONCURRENCY=5

# ── Content fetcher User-Agents ──────────────────────────────────────────
# Both Gutendex and OpenStax 403 the default httpx UA. Identify
# deployments explicitly so partner sites can whitelist us.
USER_AGENT_GUTENDEX=PagePay/1.0 (+https://pagepay.app)
USER_AGENT_OPENSTAX=PagePay/1.0 (+https://pagepay.app) Education-Ingest

# ── Seed: bootstrap admin credentials ───────────────────────────────────
# Used by `python -m app.seed` to create the very first admin row on
# an empty DB. The defaults are the dev "admin@pagepay.app / admin123"
# pair — OVERRIDE both in production. The seed is idempotent (no-op if
# any AdminUser already exists) so a misconfigured prod seed silently
# leaves you with no admin login.
SEED_ADMIN_EMAIL=admin@pagepay.app
SEED_ADMIN_PASSWORD=admin123

# ── Background task processor toggle ────────────────────────────────────
# When True the FastAPI lifespan starts the Phase 7 background task
# processor. Set True on ONE instance only (e.g. a dedicated worker
# container); setting it on every uvicorn worker makes every
# submission get processed N times.
RUN_TASK_PROCESSOR=false
