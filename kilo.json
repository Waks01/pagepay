{
  "$schema": "https://app.kilo.ai/config.json",
  "project": {
    "name": "PagePay",
    "tagline": "Read Stories & AI Exam Prep",
    "brand": {
      "primaryColor": "#6C5CE7",
      "secondaryColor": "#00B894",
      "font": "Inter",
      "logoText": "PagePay",
      "tone": "professional yet rewarding"
    }
  },
  "techStack": {
    "frontend": {
      "framework": "Expo SDK 57",
      "reactNative": "0.86",
      "react": "19.2",
      "navigation": "expo-router",
      "routesRoot": "page/src/app",
      "stateManagement": {
        "server": "TanStack Query v5",
        "client": "Zustand",
        "persistent": "expo-secure-store"
      },
      "architecture": "New Architecture (mandatory)",
      "build": "expo-dev-client (EAS Build)"
    },
    "backend": {
      "framework": "FastAPI (Python 3.11+)",
      "database": "PostgreSQL 18 (Neon in production, Render-hosted API)",
      "orm": "SQLAlchemy 2.0 (async)",
      "driver": "asyncpg",
      "deployment": "Docker container on Render.app"
    },
    "ads": {
      "primary": "Google AdMob (mediation layer)",
      "secondary": "AppLovin MAX (not implemented — inert config only)",
      "plugin": "@fumitakayamada/expo-applovin-max",
      "status": "Backend SSV live; the client pipeline is not built yet (no config plugin, no components)"
    },
    "ai": {
      "router": "Cloudflare Workers AI, single provider — no failover",
      "standard": "@cf/ibm-granite/granite-4.0-h-micro (definitions, recall)",
      "premium": "@cf/zai-org/glm-4.7-flash (reasoning, marking, generation)",
      "vision": "@cf/meta/llama-3.2-11b-vision-instruct (image + rendered PDF page OCR)",
      "tts": "@cf/myshell-ai/melotts (narration)"
    },
    "payments": {
      "primary": "Paystack",
      "fallback": null,
      "note": "Flutterwave config fields exist but are not wired to any router"
    },
    "bills": {
      "providers": ["peyflex", "bigisub"],
      "selected": "settings.bills_provider (default: peyflex)"
    }
  },
  "phases": [
    {
      "id": 1,
      "name": "Read-to-Earn Core",
      "duration": "Weeks 1-3",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase1-core.md"
      ]
    },
    {
      "id": 2,
      "name": "Ad Monetization Foundation",
      "duration": "Weeks 4-6",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase2-ads.md"
      ]
    },
    {
      "id": 3,
      "name": "Student AI Exam Prep",
      "duration": "Weeks 7-10",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase3-study.md"
      ]
    },
    {
      "id": 4,
      "name": "Payments & Premium Tier",
      "duration": "Weeks 11-13",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase4-payments.md"
      ]
    },
    {
      "id": 5,
      "name": "Referrals & Community",
      "duration": "Weeks 14-18",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase5-community.md"
      ]
    },
    {
      "id": 6,
      "name": "Licensed Content & Scale",
      "duration": "Weeks 19+",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase6-scale.md"
      ]
    },
    {
      "id": 7,
      "name": "Task Marketplace",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase7-tasks.md"
      ]
    },
    {
      "id": 8,
      "name": "Bills & VTU",
      "status": "shipped",
      "commands": [
        ".kilo/command/phase8-bills.md"
      ]
    },
    {
      "id": 9,
      "name": "Monetization Hardening",
      "status": "in_progress",
      "commands": [],
      "notes": "Model routing + metering, one paid tier (N3,000), per-user AI cost logging all shipped. Outstanding: the AdMob client pipeline, upload/exam quotas, the Granite routing eval set."
    }
  ],
  "agents": [
    {
      "id": "backend",
      "name": "Backend Engineer",
      "file": ".kilo/agent/backend.md",
      "description": "FastAPI, PostgreSQL, Docker, AI router, ad SSV"
    },
    {
      "id": "frontend",
      "name": "Frontend Engineer",
      "file": ".kilo/agent/frontend.md",
      "description": "Expo SDK 55, Expo Router, React Native New Architecture"
    },
    {
      "id": "ai-architect",
      "name": "AI Architect",
      "file": ".kilo/agent/ai.md",
      "description": "Multi-provider LLM routing, failover, prompt engineering"
    },
    {
      "id": "devops",
      "name": "DevOps Engineer",
      "file": ".kilo/agent/devops.md",
      "description": "Docker, EAS Build, CI/CD, deployment"
    }
  ],
  "snapshot": false
}